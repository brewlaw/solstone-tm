import requests

def get_trademark_status(serial_number: str, api_key: str):
    """
    Fetches trademark data from the USPTO Open Data Portal API using a serial number.
    """
    # The updated Open Data Portal base endpoint for Trademarks
    url = f"https://uspto.gov{serial_number}"
    
    # Passing the required authentication key in headers
    headers = {
        "X-API-KEY": api_key,
        "Accept": "application/json"
    }
    
    try:
        response = requests.get(url, headers=headers)
        
        # Handle HTTP rate limiting or unauthenticated keys gracefully
        if response.status_code == 401:
            print("Error: Unauthorized. Please check your USPTO API key.")
            return None
        elif response.status_code == 429:
            print("Error: Rate limit exceeded. Back off and try again later.")
            return None
            
        response.raise_for_status()
        return response.json()
        
    except requests.exceptions.RequestException as e:
        print(f"An error occurred: {e}")
        return None

